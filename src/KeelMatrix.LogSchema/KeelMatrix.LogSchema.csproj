<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>KeelMatrix.LogSchema</AssemblyName>
    <RootNamespace>KeelMatrix.LogSchema.Cli</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>logschema</ToolCommandName>
    <PackageId>KeelMatrix.LogSchema</PackageId>
    <Authors>KeelMatrix</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/KeelMatrix/LogSchema</PackageProjectUrl>
    <RepositoryUrl>https://github.com/KeelMatrix/LogSchema</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Keep package bytes independent of checkout branch metadata and clone-origin SourceLink discovery. -->
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- NuGet uses this Unix timestamp for deterministic ZIP entry metadata. -->
    <DeterministicTimestamp>315532800</DeterministicTimestamp>
    <PackageTags>dotnet-tool logging structured-logging logger-message contract compatibility observability ci</PackageTags>
    <Description>Detects breaking changes in source-generated .NET structured logging contracts. Captures and diffs LoggerMessage event IDs, names, levels, templates, and structured properties locally and in CI.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KeelMatrix.LogSchema.Core\KeelMatrix.LogSchema.Core.csproj" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="" Link="icon.png" />
  </ItemGroup>
</Project>
